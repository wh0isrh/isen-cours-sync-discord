# Copier ce fichier en .env. Les valeurs ne sont jamais affichées dans les logs.
# Laisser les identifiants JUNIA vides pour se connecter manuellement dans la fenêtre.
JUNIA_EMAIL=
JUNIA_PASSWORD=
WAIT_2FA_SECONDS=15
LOGIN_TIMEOUT_SECONDS=240

UBUNTU_HOST=192.0.2.10
UBUNTU_PORT=22
UBUNTU_USER=ton_utilisateur
# Mot de passe OU chemin de clé privée. Vide : demande dans la console.
UBUNTU_PASSWORD=
UBUNTU_SSH_KEY_PATH=
UBUNTU_SSH_KEY_PASSPHRASE=
UBUNTU_REMOTE_DIR=/srv/cours
SSH_TIMEOUT_SECONDS=30

# Facultatif : réutiliser les fichiers de l'audit pour amorcer les fichiers absents.
# Vide : recherche dans ../ISEN_Lille_2026-2027 par rapport à ce script.
AUDIT_DIR=
BOOTSTRAP_AUDIT=true

# Comparaison du contenu reçu sur Ubuntu, en plus de la taille.
VERIFY_REMOTE_HASH=true
# true : retélécharger si Moodle ne fournit ni ETag ni Last-Modified.
# false : pour les sources déjà connues, taille et hash distant suffisent.
STRICT_SOURCE_VALIDATION=false
HTTP_TIMEOUT_SECONDS=120
HTTP_RETRIES=3

# true : transférer uniquement les fichiers locaux conservés, sans accès Moodle.
LOCAL_ONLY=false
# Réveil optionnel du serveur éteint (MAC de sa carte Ethernet).
WOL_MAC=
WOL_BROADCAST=255.255.255.255
WOL_WAIT_SECONDS=120
