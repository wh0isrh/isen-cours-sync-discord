DISCORD_TOKEN=
DISCORD_GUILD_ID=
COURS_DIR=/srv/cours
COURS_VIEW_TIMEOUT=1800
# Facultatif : URL d'un serveur de téléchargement déjà configuré, accessible aux utilisateurs.
# Sans URL, les gros fichiers sont annoncés avec leur taille et leur emplacement Ubuntu.
COURS_DOWNLOAD_BASE_URL=
# Facultatif : IDs des rôles autorisés, séparés par des virgules. Vide = membres du serveur.
COURS_ALLOWED_ROLE_IDS=
# Liens signés : remplis par install_filebrowser.py, facultatifs sans tunnel.
COURS_LINK_KEY_FILE=
COURS_LINK_URL_FILE=
COURS_LINK_TTL_SECONDS=3600
# Explorateur protégé : remplis par l'installateur, jamais publier ces identifiants.
FILEBROWSER_USER=
FILEBROWSER_PASSWORD=
